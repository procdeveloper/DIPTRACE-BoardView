<?xml version="1.0" encoding="utf-8"?>
<Source Type="DipTrace_Pcb_Plugin"
        Name="Export to OpenBoardView (.brd + .bvr)"
        ExeFile="Dip2BoardView.exe"
        Hint="Write OpenBoardView boardview files from this board">
  <Settings>
    <!-- Export-only: the plugin reads the board and never sends anything back. -->
    <ExpMode>Partial</ExpMode>
    <ImpMode>None</ImpMode>
    <!-- Components bring their footprints and pad styles with them. -->
    <Comp>All</Comp>
    <Net>All</Net>
    <!-- Shapes carry the board cutouts. -->
    <Shape>All</Shape>
    <Plane>None</Plane>
    <Table>None</Table>
    <Dim>None</Dim>
    <Diff>None</Diff>
    <Board>All</Board>
    <Ratlines>None</Ratlines>
    <Stamp>No</Stamp>
    <Layers>None</Layers>
    <DesignCache>None</DesignCache>
    <Group>None</Group>
  </Settings>
</Source>
